# ============================================
# BiciCoruña - Environment Configuration
# ============================================
# Copy this file to .env and adjust values as needed
# ============================================

# ----------------
# Application
# ----------------
ENVIRONMENT=development
DEBUG=true

# ----------------
# Database
# ----------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=bicicoruna
DB_PORT=5432

# Full connection string (used by backend)
DATABASE_URL=postgresql://postgres:your_secure_password_here@localhost:5432/bicicoruna

# ----------------
# API
# ----------------
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,https://roi-automation.es

# ----------------
# Frontend
# ----------------
FRONTEND_PORT=3000

# ----------------
# External APIs
# ----------------
# Bicicoruña GBFS feed
GBFS_BASE_URL=https://acoruna.publicbikesystem.net/customer/gbfs/v2

# OpenRouteService (for routing - optional, handled by frontend)
# OPENROUTE_API_KEY=your_api_key_here

# ----------------
# n8n Integration
# ----------------
N8N_PORT=5678
N8N_HOST=localhost
N8N_USER=admin
N8N_PASSWORD=your_n8n_password_here
N8N_BASE_URL=http://localhost:5678
N8N_WEBHOOK_URL=http://localhost:5678
N8N_WEBHOOK_SECRET=your_webhook_secret_here

# ----------------
# Data Ingestion
# ----------------
# How often to fetch fresh data (in seconds)
INGESTION_INTERVAL_SECONDS=120
