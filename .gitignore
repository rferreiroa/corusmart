# ----------------
# Environment
# ----------------
.env
.env.local
.env.*.local
*.env

# ----------------
# Python
# ----------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
venv/
ENV/
env/
.venv/

# ----------------
# IDE
# ----------------
.idea/
.vscode/
*.swp
*.swo
*~
.project
.pydevproject
.settings/
*.sublime-workspace
*.sublime-project

# ----------------
# OS
# ----------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ----------------
# Node.js (if using frontend bundler)
# ----------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm
.yarn-integrity

# ----------------
# Docker
# ----------------
*.log

# ----------------
# Database
# ----------------
*.db
*.sqlite
*.sqlite3

# ----------------
